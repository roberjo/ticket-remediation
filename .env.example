# Copy to .env and fill in real credentials for production use.
# For local zero-budget development against the mock servers, copy .env.mock.example instead.

# --- ServiceNow ---
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_API_TOKEN=
SNOW_AVIT_TABLE=x_avit_findings

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AVREM
JIRA_REMEDIATION_JQL_STATUS=Ready for Remediation

# --- GitHub ---
GITHUB_TOKEN=

# --- LLM remediation provider: anthropic | gemini ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Gemini is a free-tier alternative (get a key at https://aistudio.google.com/apikey);
# see .env.mock.example for the zero-budget default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Notifications ---
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
NOTIFY_EMAIL_TO=

# --- Local paths ---
SQLITE_DB_PATH=data/state.db
INGEST_MAPPING_PATH=config/ingest_mapping.yaml
REPO_ROUTING_PATH=config/repo_routing.yaml
WORK_DIR=work
