[Unit]
Description=ticket-remediation: remediate run (Jira -> GitHub PR)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ticket-remediation
WorkingDirectory=/opt/ticket-remediation
EnvironmentFile=/opt/ticket-remediation/.env
ExecStart=/opt/ticket-remediation/.venv/bin/python -m ticket_remediation.remediate run
