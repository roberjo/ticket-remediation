# Zero-budget local dev: copy to .env and point everything at the local mock servers
# (uv run python -m mock_servers.run_all) instead of real ServiceNow/Jira accounts.
# The mock servers accept any bearer token / basic auth value without validating it,
# so the connector auth code paths still exercise normally.

# --- ServiceNow (mocked) ---
SNOW_INSTANCE_URL=http://localhost:8001
SNOW_API_TOKEN=mock-token
SNOW_AVIT_TABLE=x_avit_findings

# --- Jira (mocked) ---
JIRA_BASE_URL=http://localhost:8002
JIRA_EMAIL=dev@example.com
JIRA_API_TOKEN=mock-token
JIRA_PROJECT_KEY=AVREM
JIRA_REMEDIATION_JQL_STATUS=Ready for Remediation

# --- GitHub: still real. Use a private sandbox repo under your own account. ---
GITHUB_TOKEN=

# --- LLM remediation provider: Gemini's free tier, so this is genuinely zero-budget end to end. ---
# Get a key at https://aistudio.google.com/apikey (no billing account required for the free tier).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Swap to LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY if you'd rather pay for higher quality.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Notifications: point at real webhooks/SMTP, or leave blank to skip that channel. ---
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
NOTIFY_EMAIL_TO=

# --- Local paths ---
SQLITE_DB_PATH=data/state.db
INGEST_MAPPING_PATH=config/ingest_mapping.yaml
REPO_ROUTING_PATH=config/repo_routing.yaml
WORK_DIR=work
